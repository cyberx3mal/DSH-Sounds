{
  "name": "dsh-plugin-project-sounds",
  "version": "1.1.0",
  "private": false,
  "description": "Per-project sound notifications for the DeepSeek Harness Web UI: distinct cues for turn completion, pending approval/question, and failures (errors, quotas, context limits, blocked goals, crashed subagents, failed background jobs), with optional repeats until the project is opened.",
  "license": "MIT",
  "author": "cyberx3mal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyberx3mal/DSH-Sounds.git"
  },
  "bugs": {
    "url": "https://github.com/cyberx3mal/DSH-Sounds/issues"
  },
  "homepage": "https://github.com/cyberx3mal/DSH-Sounds#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sound",
    "notifications",
    "workspace"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
